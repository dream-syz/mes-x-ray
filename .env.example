# MES X-Ray environment variables — copy to .env (git-ignored) and fill in locally.
# Never commit real hosts, credentials or tokens. Placeholders only (design §10).

# --- AI provider (optional; default provider "rules" needs nothing) ---------------------------
# Company-approved OpenAI-compatible endpoint. The key is read from the variable below by name.
XRay__AI__Provider=rules
XRay__AI__BaseUrl=
XRay__AI__Model=gpt-4o-mini
MESXRAY_AI_API_KEY=

# --- Fixture / graph ---------------------------------------------------------------------------
XRay__Fixtures__Root=fixtures/pick-order-details
XRay__Graph__Mode=ScanAndCurate
XRay__Graph__ExportPath=

# --- Runtime adapter ---------------------------------------------------------------------------
# Comma-separated list is not supported by the configuration binder; use indexed keys.
XRay__Runtime__AllowedEnvironments__0=FIXTURE
XRay__Runtime__AllowedEnvironments__1=TEST
XRay__Runtime__AllowedEnvironments__2=UAT
XRay__Runtime__MaxRows=200

# --- Web UI (Vite reads VITE_* only) -----------------------------------------------------------
VITE_XRAY_API_URL=http://localhost:5080
