<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Tests may use synchronous helpers and literal test data freely. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA1515</NoWarn>
  </PropertyGroup>

  <!-- Item groups are evaluated after all properties, so a project can opt out with <IsTestProject>false</IsTestProject>. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'false'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
