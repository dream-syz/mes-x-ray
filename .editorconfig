root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.sql]
indent_size = 4

[*.cs]
# Naming / style
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = false:none

# Analyzer tuning for a read-mostly POC codebase
dotnet_diagnostic.CA1002.severity = none   # exposing List<T> in DTOs is acceptable here
dotnet_diagnostic.CA1034.severity = none   # nested types for grouping
dotnet_diagnostic.CA1707.severity = none   # underscores in test names and SQL identifiers
dotnet_diagnostic.CA1724.severity = none   # type names may overlap namespaces
dotnet_diagnostic.CA1305.severity = none   # invariant globalization is enabled
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1860.severity = none
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA1819.severity = none   # arrays in DTOs
dotnet_diagnostic.CA1024.severity = none
dotnet_diagnostic.CA1308.severity = none   # camelCase JSON needs ToLowerInvariant
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA2227.severity = none   # settable collections in JSON DTOs
dotnet_diagnostic.CA1508.severity = none
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.CS1591.severity = none
