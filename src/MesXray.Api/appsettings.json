{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5080" }
    }
  },
  "XRay": {
    "Fixtures": {
      "Root": "fixtures/pick-order-details"
    },
    "Graph": {
      "Mode": "ScanAndCurate",
      "ExportPath": null
    },
    "CorsOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ],
    "Runtime": {
      "FixtureRoot": "",
      "AllowedEnvironments": [ "FIXTURE", "TEST", "UAT" ],
      "MaxRows": 200,
      "Timeout": "00:00:10",
      "MaxArgumentLength": 100
    },
    "AI": {
      "Provider": "rules",
      "BaseUrl": null,
      "Model": "gpt-4o-mini",
      "ApiKeyEnvironmentVariable": "MESXRAY_AI_API_KEY",
      "PromptVersion": "explain-v1",
      "MaxEvidenceItems": 120,
      "Timeout": "00:00:30",
      "FallbackToRules": true
    }
  }
}
